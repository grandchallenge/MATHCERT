{
  "schema_version": "1.1.0",
  "control_id": "MC-PLATFORM-LANE-001",
  "contextual_certification_control_id": "MC-CONTEXT-AWARE-CERTIFY-001",
  "state": "ACTIVE_WHEN_PROTECTED",
  "repository": "grandchallenge/MATHCERT",
  "platform_branch_prefix": "platform/certification/",
  "shared_platform_paths": [
    ".github/workflows/ci.yml",
    ".github/workflows/gcl-conformance.yml",
    "requirements-ci.txt",
    "ci/check_lean.sh",
    "ci/check_lean.ps1",
    "ci/otp_finalize_family_replay_evidence.py",
    "ci/otp_landrun_argv_adapter.sh",
    "ci/audit_ci_reachability.py",
    "ci/test_audit_ci_reachability.py"
  ],
  "stateful_shared_validator_paths": [
    "ci/validate_certification_routes.py",
    "ci/test_validate_certification_routes.py",
    "ci/validate_formal_target_certificates.py",
    "ci/test_formal_target_certificates.py",
    "ci/otp_full_formula_route_proposal_compat.py",
    "ci/test_openai_ten_proofs_permanent_route_proposal_with_full_formula_successor.py",
    "ci/validate_otp_replay_readback_reconciliation.py",
    "ci/test_otp_replay_readback_reconciliation.py"
  ],
  "lane_support_paths": [
    "governance/certification_platform_lane.json",
    "ci/check_certification_platform_lane.py",
    "ci/test_check_certification_platform_lane.py",
    "ci/test_otp_finalize_family_replay_evidence.py"
  ],
  "rules": {
    "platform_only_paths_require_platform_branch": true,
    "stateful_validator_generic_defect_repairs_require_platform_branch": true,
    "stateful_validator_family_transition_updates_may_remain_on_family_branch": true,
    "platform_branch_may_change_only_declared_paths": true,
    "family_scoped_certification_allowed_only_for_one_unambiguous_family": true,
    "unknown_or_multi_family_changes_require_full_estate": true,
    "platform_changes_require_full_estate": true,
    "non_pull_request_runs_require_full_estate": true,
    "explicit_force_full_mode_supported": true,
    "family_certificate_or_evidence_authority": false,
    "mathematical_authority": false,
    "aggregate_authority": false,
    "promotion_authority": false
  },
  "operating_rule": "Family-agnostic shared infrastructure is admitted only through platform/certification/* branches. Stateful shared validators may receive bounded family-transition registration/compatibility updates on a family branch, but any repair to their generic validation semantics belongs on the platform lane. Canonical certification runs the invariant/shared core plus only the one unambiguously affected result-family control set; platform, non-pull-request, unknown, route-only without family evidence, and multi-family changes fail closed to the full validation estate. Family branches consume protected platform-only helpers and must not carry private revisions of them."
}
