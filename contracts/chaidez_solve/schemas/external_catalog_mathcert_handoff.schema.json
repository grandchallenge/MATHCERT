{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External catalog supplement to the generic MATHCERT handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_class",
    "handoff_id",
    "promotion_id",
    "promotion_registry",
    "dossier",
    "generic_handoff",
    "catalog_source",
    "selected_claim",
    "global_theorem_spine_id",
    "theorem_spine_node",
    "proof_debt_ids",
    "trust_quartet",
    "support_route_class",
    "local_replay_evidence",
    "certification_route_id",
    "independent_verification",
    "non_claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "record_class": {
      "enum": [
        "PRODUCTION",
        "NON_AUTHORITATIVE_CANARY"
      ]
    },
    "handoff_id": {
      "type": "string",
      "pattern": "^MS-CAT-HANDOFF-[A-Z0-9-]+$"
    },
    "promotion_id": {
      "type": "string",
      "pattern": "^MS-CAT-PROMOTION-[A-Z0-9-]+$"
    },
    "promotion_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "git_blob_sha1",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*:)[A-Za-z0-9_.\\-/]+$",
          "minLength": 1
        },
        "section_anchor": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
        },
        "git_blob_sha1": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "dossier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "git_blob_sha1",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*:)[A-Za-z0-9_.\\-/]+$",
          "minLength": 1
        },
        "section_anchor": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
        },
        "git_blob_sha1": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "generic_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "git_blob_sha1",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*:)[A-Za-z0-9_.\\-/]+$",
          "minLength": 1
        },
        "section_anchor": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
        },
        "git_blob_sha1": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "catalog_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_id",
        "catalog_release_id",
        "provider_id",
        "snapshot_id",
        "raw_sha256",
        "normalized_sha256",
        "assurance_tier",
        "programme_import",
        "catalog_shard",
        "exact_campaign_target",
        "campaign_id",
        "reviewed_relation_id"
      ],
      "properties": {
        "catalog_id": {
          "type": "string",
          "pattern": "^GCL-CAT-[A-Z0-9-]+$"
        },
        "catalog_release_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "provider_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "raw_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "normalized_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "assurance_tier": {
          "enum": [
            "SEMANTICALLY_REVIEWED",
            "CAMPAIGN_CONCORDANT"
          ]
        },
        "programme_import": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "commit",
            "artifact"
          ],
          "properties": {
            "repository": {
              "enum": [
                "grandchallenge/MATH-PROGRAMME",
                "grandchallenge/MATHFORGE",
                "grandchallenge/MATHSOLVE",
                "grandchallenge/MATHCERT"
              ]
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "artifact": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "git_blob_sha1",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*:)[A-Za-z0-9_.\\-/]+$",
                  "minLength": 1
                },
                "section_anchor": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                },
                "git_blob_sha1": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        },
        "catalog_shard": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "commit",
            "artifact"
          ],
          "properties": {
            "repository": {
              "enum": [
                "grandchallenge/MATH-PROGRAMME",
                "grandchallenge/MATHFORGE",
                "grandchallenge/MATHSOLVE",
                "grandchallenge/MATHCERT"
              ]
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "artifact": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "git_blob_sha1",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*:)[A-Za-z0-9_.\\-/]+$",
                  "minLength": 1
                },
                "section_anchor": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                },
                "git_blob_sha1": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        },
        "exact_campaign_target": {
          "type": "boolean"
        },
        "campaign_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reviewed_relation_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "exact_campaign_target": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "assurance_tier": {
                "const": "CAMPAIGN_CONCORDANT"
              },
              "reviewed_relation_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      ]
    },
    "selected_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "statement",
        "node_id",
        "status",
        "proof_debt_ids",
        "requires_external_verification"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "node_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "OPEN",
            "CONDITIONAL",
            "CHECKED",
            "PROVED",
            "REFUTED"
          ]
        },
        "proof_debt_ids": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "requires_external_verification": {
          "type": "boolean"
        }
      }
    },
    "global_theorem_spine_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "theorem_spine_node": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "proof_debt_ids": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "trust_quartet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "WHAT_IS_PROVED",
        "WHAT_IS_CHECKED",
        "WHAT_REMAINS_OPEN",
        "WHAT_REQUIRES_EXTERNAL_VERIFICATION"
      ],
      "properties": {
        "WHAT_IS_PROVED": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "answer",
            "claim_ids",
            "debt_ids"
          ],
          "properties": {
            "answer": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "claim_ids": {
              "type": "array",
              "minItems": 0,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "debt_ids": {
              "type": "array",
              "minItems": 0,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        "WHAT_IS_CHECKED": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "answer",
            "claim_ids",
            "debt_ids"
          ],
          "properties": {
            "answer": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "claim_ids": {
              "type": "array",
              "minItems": 0,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "debt_ids": {
              "type": "array",
              "minItems": 0,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        "WHAT_REMAINS_OPEN": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "answer",
            "claim_ids",
            "debt_ids"
          ],
          "properties": {
            "answer": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "claim_ids": {
              "type": "array",
              "minItems": 0,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "debt_ids": {
              "type": "array",
              "minItems": 0,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        "WHAT_REQUIRES_EXTERNAL_VERIFICATION": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "answer",
            "claim_ids",
            "debt_ids"
          ],
          "properties": {
            "answer": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "claim_ids": {
              "type": "array",
              "minItems": 0,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "debt_ids": {
              "type": "array",
              "minItems": 0,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    "support_route_class": {
      "enum": [
        "EXPLORATORY_EVIDENCE",
        "REGRESSION_AUDIT",
        "EXACT_FINITE_VERIFICATION",
        "CERTIFICATE_REPLAY",
        "FORMAL_PROOF",
        "CONTINUUM_PROOF",
        "NEGATIVE_RESULT"
      ]
    },
    "local_replay_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "git_blob_sha1",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*:)[A-Za-z0-9_.\\-/]+$",
            "minLength": 1
          },
          "section_anchor": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "git_blob_sha1": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "certification_route_id": {
      "type": "string",
      "pattern": "^MC-ROUTE-[A-Z0-9-]+$"
    },
    "independent_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "evidence"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "REQUIRED_PENDING",
            "EVIDENCE_SUBMITTED"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "git_blob_sha1",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*:)[A-Za-z0-9_.\\-/]+$",
                "minLength": 1
              },
              "section_anchor": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              },
              "git_blob_sha1": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "non_claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "certification_inferred",
        "catalog_status_is_local_result",
        "unscoped_campaign_claim"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "certification_inferred": {
          "const": false
        },
        "catalog_status_is_local_result": {
          "const": false
        },
        "unscoped_campaign_claim": {
          "const": false
        }
      }
    }
  }
}
