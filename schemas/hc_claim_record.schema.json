{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/grandchallenge/MATHCERT/schemas/hc_claim_record.schema.json",
  "title": "Hodge campaign claim record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "campaign_id",
    "name",
    "base_field",
    "geometric_category",
    "smoothness",
    "properness_profile",
    "dimension_scope",
    "codimension_scope",
    "coefficient_ring",
    "cohomology_theory",
    "input_class_predicate",
    "cycle_object",
    "cycle_equivalence",
    "quantifier_scope",
    "conclusion_type",
    "implication_direction",
    "status",
    "source_records",
    "claims_not_made"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^HC-[A-Z0-9-]+$"
    },
    "campaign_id": {
      "type": "string",
      "const": "HC-001"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "base_field": {
      "type": "string",
      "enum": ["C", "characteristic_zero", "finite_field", "finitely_generated_field", "other_explicit"]
    },
    "geometric_category": {
      "type": "string",
      "enum": [
        "smooth_projective_variety",
        "smooth_proper_variety",
        "compact_kahler_manifold",
        "algebraic_family",
        "other_explicit"
      ]
    },
    "smoothness": {
      "type": "string",
      "enum": ["smooth", "singular_allowed", "other_explicit"]
    },
    "properness_profile": {
      "type": "string",
      "enum": ["projective", "proper", "compact_kahler", "quasi_projective", "other_explicit"]
    },
    "dimension_scope": {
      "oneOf": [
        {"type": "integer", "minimum": 0},
        {"type": "string", "minLength": 1}
      ]
    },
    "codimension_scope": {
      "oneOf": [
        {"type": "integer", "minimum": 0},
        {"type": "string", "minLength": 1}
      ]
    },
    "coefficient_ring": {
      "type": "string",
      "enum": ["Q", "Z", "Q_l", "R", "C", "other_explicit"]
    },
    "cohomology_theory": {
      "type": "string",
      "minLength": 1
    },
    "comparison_maps": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true,
      "default": []
    },
    "input_class_predicate": {
      "type": "string",
      "minLength": 1
    },
    "cycle_object": {
      "type": "string",
      "enum": [
        "CH_p_tensor_Q",
        "integral_algebraic_cycles",
        "analytic_cycles",
        "coherent_sheaf_chern_classes",
        "motivated_correspondences",
        "Tate_classes",
        "other_explicit"
      ]
    },
    "cycle_equivalence": {
      "type": "string",
      "enum": [
        "rational_equivalence",
        "algebraic_equivalence",
        "homological_equivalence",
        "numerical_equivalence",
        "not_applicable",
        "other_explicit"
      ]
    },
    "quantifier_scope": {
      "type": "string",
      "enum": [
        "every_variety_every_class",
        "every_variety_in_restricted_family_every_class",
        "very_general_variety",
        "generic_fiber",
        "single_explicit_variety",
        "sampled_classes",
        "other_explicit"
      ]
    },
    "conclusion_type": {
      "type": "string",
      "enum": [
        "cycle_class_surjectivity",
        "single_class_algebraicity",
        "support_coniveau",
        "deformation_transport",
        "Hodge_locus_algebraicity",
        "absolute_Hodge_stability",
        "motivated_generation",
        "Tate_surjectivity",
        "effective_representability",
        "other_explicit"
      ]
    },
    "conditional_dependencies": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true,
      "default": []
    },
    "implication_direction": {
      "type": "string",
      "enum": [
        "algebraic_to_Hodge",
        "Hodge_to_algebraic",
        "equivalence",
        "one_way_explicit",
        "parallel_requires_bridge",
        "no_implication_claimed"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "PROVED_IN_PACKAGE",
        "FORMALIZED",
        "LITERATURE_DERIVED",
        "OPEN",
        "CONDITIONAL",
        "FALSE_IN_GENERAL",
        "NEEDS_AUDIT",
        "HEURISTIC",
        "REFUTED"
      ]
    },
    "source_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "audit_state"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "theorem_locator": {"type": "string"},
          "audit_state": {
            "type": "string",
            "enum": [
              "AUDITED",
              "STATEMENT_AUDITED",
              "METADATA_AUDITED",
              "THEOREM_BODY_PENDING",
              "TRANSLATION_PENDING",
              "UNVERIFIED"
            ]
          }
        }
      }
    },
    "claims_not_made": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "uniqueItems": true
    },
    "notes": {
      "type": "string"
    }
  }
}
