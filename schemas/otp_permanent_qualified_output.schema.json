{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/otp_permanent_qualified_output.schema.json",
  "title": "OTP-C-PERMANENT Restricted Qualification Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "certificate_id",
    "result_family",
    "route_id",
    "source_authority",
    "encoded_targets",
    "qualification",
    "evidence_receipts",
    "axiom_report",
    "trust_boundary",
    "state",
    "preserved_limitations",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "otp_permanent_qualified_output"},
    "certificate_id": {"const": "MC-OTP-C-PERMANENT-QUAL-001"},
    "result_family": {"const": "OTP-C-PERMANENT"},
    "route_id": {"const": "MC-ROUTE-OTP-C-PERMANENT-FORMULA"},
    "source_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adjudication", "output_contract"],
      "properties": {
        "adjudication": {
          "const": {
            "path": "governance/result_family_adjudications/OTP-C-PERMANENT.json",
            "digest_algorithm": "git_blob_sha1",
            "digest": "233d3e92ceed6654e6f6759718adf32f1b6c5415",
            "disposition": "adjudication_clear_encoded_targets_only",
            "merge_commit": "685faa7730b7147ba70ae0d0bb5fdd916b68c1a7"
          }
        },
        "output_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "digest_algorithm", "digest"],
          "properties": {
            "path": {"const": "governance/result_family_output_contracts/OTP-C-PERMANENT.json"},
            "digest_algorithm": {"const": "git_blob_sha1"},
            "digest": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          }
        }
      }
    },
    "encoded_targets": {
      "const": [
        "PermanentFormulaLowerBound.permanent_divisionFree_formula_logarithmic_lower_bound",
        "PermanentFormulaLowerBound.permanent_rational_formula_logarithmic_lower_bound"
      ]
    },
    "qualification": {
      "const": {
        "disposition": "qualified_encoded_targets_only",
        "scope": "The exact two encoded Permanent variable-leaf formula targets only.",
        "source_projection": {
          "coefficient_field": "complex",
          "dimension_threshold": 32,
          "log_base": 2,
          "division_free_variable_leaf_constant": 128,
          "rational_variable_leaf_constant": 192,
          "formula_target_count": 2,
          "circuit_target_count": 0
        }
      }
    },
    "evidence_receipts": {
      "const": {
        "comparator": "pass",
        "lean_kernel": "accept",
        "nanoda": "accept",
        "source_statement_concordance": "clear_for_complex_n_ge_32_log2_variable_leaf_constants_128_192",
        "nonvacuity": "clear_for_both_protected_formula_witnesses"
      }
    },
    "axiom_report": {
      "const": {
        "permitted_axioms": ["Classical.choice", "Quot.sound", "propext"],
        "unexpected_axioms": [],
        "imported_domain_axioms": []
      }
    },
    "trust_boundary": {
      "const": {
        "solution_placeholders": 0,
        "unsafe_declarations": 0,
        "custom_axioms": 0,
        "result": "clear"
      }
    },
    "state": {
      "const": {
        "route_state": "qualified",
        "cert_output_inserted": true,
        "mathematical_target_proved": false,
        "may_promote_claim": false,
        "aggregate_output": false
      }
    },
    "preserved_limitations": {
      "const": {
        "circuit_targets_in_scope": false,
        "gate_bounds_in_scope": false,
        "total_size_consequences_in_scope": false,
        "historical_pdf_byte_equivalence": "not_established",
        "unrestricted_source_theorem_proof_claim": false,
        "other_family_outputs_authorized": false,
        "aggregate_openai_ten_proofs_authority": false
      }
    },
    "claim_boundary": {
      "const": "This restricted qualification certifies only the exact two encoded OTP-C-PERMANENT variable-leaf formula targets under the protected adjudication and output contract. It does not certify source Theorem 1.1 arithmetic-circuit complexity, any PermanentRollout circuit target, the separate 256/384 internal-gate bounds, total-leaf or total-vertex consequences, historical admitted-PDF byte equivalence, or an unrestricted broader source theorem; it does not mark a mathematical target proved, authorize claim promotion, qualify another result family, create aggregate OpenAI Ten Proofs authority, or authorize novelty, priority, publication, patentability, product, or commercial claims."
    }
  }
}
