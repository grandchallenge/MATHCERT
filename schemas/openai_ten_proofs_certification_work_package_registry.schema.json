{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/openai_ten_proofs_certification_work_package_registry.schema.json",
  "title": "OpenAI ten-proofs certification work-package registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "registry_id",
    "candidate_id",
    "authority",
    "work_packages",
    "execution_state",
    "blocked_repair_lanes",
    "aggregate_integration",
    "route_controls",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "openai_ten_proofs_certification_work_package_registry"},
    "registry_id": {"const": "MC-OTP-CERT-WP01"},
    "candidate_id": {"const": "OPENAI-TEN-PROOFS-001"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cert_intake_merge", "cert_intake_reviewed_head", "cert_intake_review_id"],
      "properties": {
        "cert_intake_merge": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "cert_intake_reviewed_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "cert_intake_review_id": {"type": "integer", "minimum": 1}
      }
    },
    "work_packages": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["result_family", "work_package_id", "tracker_issue", "path", "digest_algorithm", "digest"],
        "properties": {
          "result_family": {"type": "string", "minLength": 1},
          "work_package_id": {"type": "string", "minLength": 1},
          "tracker_issue": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "digest_algorithm": {"const": "git_blob_sha1"},
          "digest": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
        }
      }
    },
    "execution_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorized_work_package_count",
        "executing_count",
        "evidence_bundle_count",
        "proposed_route_count",
        "registered_route_count",
        "adjudication_count",
        "cert_output_count",
        "mathematical_target_proved_count"
      ],
      "properties": {
        "authorized_work_package_count": {"const": 3},
        "executing_count": {"const": 0},
        "evidence_bundle_count": {"const": 0},
        "proposed_route_count": {"const": 0},
        "registered_route_count": {"const": 0},
        "adjudication_count": {"const": 0},
        "cert_output_count": {"const": 0},
        "mathematical_target_proved_count": {"const": 0}
      }
    },
    "blocked_repair_lanes": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 2,
      "maxItems": 2
    },
    "aggregate_integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation", "reopens_family_replay", "reopens_semantic_gates", "creates_work_package", "creates_cert_route"],
      "properties": {
        "obligation": {"type": "string", "minLength": 1},
        "reopens_family_replay": {"const": false},
        "reopens_semantic_gates": {"const": false},
        "creates_work_package": {"const": false},
        "creates_cert_route": {"const": false}
      }
    },
    "route_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "global_certification_route_registry_modified",
        "aggregate_work_package",
        "aggregate_route_prohibited",
        "result_family_granularity",
        "may_adjudicate",
        "may_promote_claim"
      ],
      "properties": {
        "global_certification_route_registry_modified": {"const": false},
        "aggregate_work_package": {"type": "null"},
        "aggregate_route_prohibited": {"const": true},
        "result_family_granularity": {"const": true},
        "may_adjudicate": {"const": false},
        "may_promote_claim": {"const": false}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  }
}
