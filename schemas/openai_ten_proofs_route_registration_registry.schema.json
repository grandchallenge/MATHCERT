{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/openai_ten_proofs_route_registration_registry.schema.json",
  "title": "OpenAI ten-proofs route registration registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","record_type","record_id","candidate_id","tracker_issue","authority","state","registrations","preserved_limitations","route_controls","activation","claim_boundary"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "openai_ten_proofs_route_registration_registry"},
    "record_id": {"const": "MC-OPENAI-TEN-PROOFS-WP06-ROUTE-REGISTRATIONS"},
    "candidate_id": {"const": "OPENAI-TEN-PROOFS-001"},
    "tracker_issue": {"const": "https://github.com/grandchallenge/MATHCERT/issues/55"},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["proposal_pr_head","proposal_merge","proposal_review","proposal_registry","registered_route_registry_before_blob","registered_route_registry_blob"],
      "properties": {
        "proposal_pr_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "proposal_merge": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "proposal_review": {"type": "object", "additionalProperties": false, "required": ["reviewer","state","submitted_at"], "properties": {"reviewer": {"const": "jimsteeg"}, "state": {"const": "APPROVED"}, "submitted_at": {"type": "string", "minLength": 10}}},
        "proposal_registry": {"$ref": "#/$defs/artifact"},
        "registered_route_registry_before_blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "registered_route_registry_blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "state": {"type": "object", "additionalProperties": false, "required": ["proposal_count","registered_route_count","submitted_route_count","adjudication_count","cert_output_count","mathematical_target_proved_count","aggregate_route_count"], "properties": {"proposal_count": {"type": "integer", "minimum": 0}, "registered_route_count": {"type": "integer", "minimum": 0}, "submitted_route_count": {"type": "integer", "minimum": 0}, "adjudication_count": {"type": "integer", "minimum": 0}, "cert_output_count": {"type": "integer", "minimum": 0}, "mathematical_target_proved_count": {"type": "integer", "minimum": 0}, "aggregate_route_count": {"type": "integer", "minimum": 0}}},
    "registrations": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["result_family","route_id","proposal","source_manifest","intake_packet","intake_status","target_claim_ids","cert_output","may_adjudicate","mathematical_target_proved","may_promote_claim"], "properties": {"result_family": {"enum": ["OTP-F-EHRHART","OTP-J1-COMPACTNESS","OTP-J2-TWO-DEGENERATE"]}, "route_id": {"type": "string", "pattern": "^MC-ROUTE-OTP-[A-Z0-9-]+$"}, "proposal": {"$ref": "#/$defs/artifact"}, "source_manifest": {"$ref": "#/$defs/artifact"}, "intake_packet": {"$ref": "#/$defs/artifact"}, "intake_status": {"const": "submitted"}, "target_claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "cert_output": {"type": "null"}, "may_adjudicate": {"const": false}, "mathematical_target_proved": {"const": false}, "may_promote_claim": {"const": false}}}},
    "preserved_limitations": {"type": "object", "additionalProperties": false, "required": ["whole_document_byte_equivalence","whole_document_semantic_equivalence","proof_bodies_compared_in_full","unexamined_result_family_count","blocked_repair_lanes","all_lean_state"], "properties": {"whole_document_byte_equivalence": {"const": "not_established"}, "whole_document_semantic_equivalence": {"const": "not_established"}, "proof_bodies_compared_in_full": {"const": false}, "unexamined_result_family_count": {"const": 9}, "blocked_repair_lanes": {"const": ["OTP-C-PERMANENT","OTP-H-GAPCVP"]}, "all_lean_state": {"const": "failed_namespace_collision"}}},
    "route_controls": {"type": "object", "additionalProperties": false, "required": ["registration_scope","may_adjudicate","may_issue_cert_output","may_mark_target_proved","aggregate_route_prohibited","may_promote_claim"], "properties": {"registration_scope": {"const": "exact_three_result_families"}, "may_adjudicate": {"const": false}, "may_issue_cert_output": {"const": false}, "may_mark_target_proved": {"const": false}, "aggregate_route_prohibited": {"const": true}, "may_promote_claim": {"const": false}}},
    "activation": {"type": "object", "additionalProperties": false, "required": ["condition","head_change_requires_reapproval","effect"], "properties": {"condition": {"type": "string", "minLength": 20}, "head_change_requires_reapproval": {"const": true}, "effect": {"const": "three_routes_registered_no_adjudication_no_outputs"}}},
    "claim_boundary": {"type": "string", "minLength": 200}
  },
  "$defs": {"artifact": {"type": "object", "additionalProperties": false, "required": ["repository","commit_sha","path","digest_algorithm","digest"], "properties": {"repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}, "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "path": {"type": "string", "minLength": 1}, "digest_algorithm": {"const": "git_blob_sha1"}, "digest": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}}}
}
