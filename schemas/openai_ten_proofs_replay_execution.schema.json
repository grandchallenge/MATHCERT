{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/openai_ten_proofs_replay_execution.schema.json",
  "title": "OpenAI ten-proofs result-family replay execution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "execution_id",
    "candidate_id",
    "authority",
    "workflow",
    "source_revision",
    "families",
    "execution_state",
    "route_controls",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "openai_ten_proofs_replay_execution"},
    "execution_id": {"const": "MC-OTP-CERT-REPLAY-001"},
    "candidate_id": {"const": "OPENAI-TEN-PROOFS-001"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_package_merge", "reviewed_head", "review_id", "reviewer"],
      "properties": {
        "work_package_merge": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "reviewed_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "review_id": {"type": "integer", "minimum": 1},
        "reviewer": {"type": "string", "minLength": 1}
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "clean_room_matrix", "toolchain"],
      "properties": {
        "path": {"const": ".github/workflows/otp-family-replay.yml"},
        "clean_room_matrix": {"const": true},
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lean", "comparator", "lean4export", "lean4checker", "landrun", "nanoda"],
          "properties": {
            "lean": {"const": "4.32.0"},
            "comparator": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "lean4export": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "lean4checker": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "landrun": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "nanoda": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          }
        }
      }
    },
    "source_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "forge_audit_issue",
        "admitted_manuscript",
        "observed_manuscript",
        "reasoning_notes",
        "current_revision_semantic_concordance"
      ],
      "properties": {
        "status": {"const": "source_revision_drift_detected"},
        "forge_audit_issue": {"const": "https://github.com/grandchallenge/MATHFORGE/issues/52"},
        "admitted_manuscript": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bytes", "sha256"],
          "properties": {
            "bytes": {"const": 2266052},
            "sha256": {"const": "f318c6508c9d49ef876a5a26cd73928705f96c07bb43e92a0cb35bd3f666ea53"}
          }
        },
        "observed_manuscript": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bytes", "sha256", "observed_at"],
          "properties": {
            "bytes": {"const": 2266371},
            "sha256": {"const": "64b900d5fae6fe22f2ae1b8e3b712d20055194a6c81cf343a2455e5898ac7dd6"},
            "observed_at": {"const": "2026-08-02"}
          }
        },
        "reasoning_notes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bytes", "sha256", "status"],
          "properties": {
            "bytes": {"const": 441468},
            "sha256": {"const": "13b95999f060c0be2142089cfb8b17b75e9231c3c1f3fa0980445ff1b35f0b3b"},
            "status": {"const": "byte_identical"}
          }
        },
        "current_revision_semantic_concordance": {"const": "blocked_pending_forge_audit"}
      }
    },
    "families": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["result_family", "tracker_issue", "config", "solution_module", "challenge_module"],
        "properties": {
          "result_family": {"enum": ["OTP-F-EHRHART", "OTP-J1-COMPACTNESS", "OTP-J2-TWO-DEGENERATE"]},
          "tracker_issue": {"type": "string", "pattern": "^https://github.com/grandchallenge/MATHCERT/issues/(48|49|50)$"},
          "config": {"type": "string", "minLength": 1},
          "solution_module": {"type": "string", "minLength": 1},
          "challenge_module": {"type": "string", "minLength": 1}
        }
      }
    },
    "execution_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "submitted_family_count", "completed_family_count", "evidence_bundle_count", "proposed_route_count", "registered_route_count", "adjudication_count", "cert_output_count", "mathematical_target_proved_count"],
      "properties": {
        "state": {"const": "submitted_for_exact_head_ci_execution"},
        "submitted_family_count": {"const": 3},
        "completed_family_count": {"const": 0},
        "evidence_bundle_count": {"const": 0},
        "proposed_route_count": {"const": 0},
        "registered_route_count": {"const": 0},
        "adjudication_count": {"const": 0},
        "cert_output_count": {"const": 0},
        "mathematical_target_proved_count": {"const": 0}
      }
    },
    "route_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["global_route_registry_modified", "aggregate_route_prohibited", "may_adjudicate", "may_promote_claim"],
      "properties": {
        "global_route_registry_modified": {"const": false},
        "aggregate_route_prohibited": {"const": true},
        "may_adjudicate": {"const": false},
        "may_promote_claim": {"const": false}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  }
}
