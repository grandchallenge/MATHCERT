{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/certification_route_registry.schema.json",
  "title": "MATHCERT certification route registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "provider_repository",
    "provider_base_commit",
    "programme_issue",
    "routes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "registry_id": {
      "const": "MC-CERTIFICATION-ROUTES"
    },
    "provider_repository": {
      "const": "grandchallenge/MATHCERT"
    },
    "provider_base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "programme_issue": {
      "type": "string",
      "pattern": "^https://github.com/grandchallenge/MATH-PROGRAMME/issues/[0-9]+$"
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": false,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "route_id",
          "campaign_id",
          "tracker_issue",
          "source_manifest",
          "intake_status",
          "target_claim_ids",
          "claim_boundary",
          "cert_output"
        ],
        "properties": {
          "route_id": {
            "type": "string",
            "pattern": "^MC-ROUTE-[A-Z0-9-]+$"
          },
          "campaign_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]+$"
          },
          "tracker_issue": {
            "type": "string",
            "pattern": "^https://github.com/grandchallenge/MATHCERT/issues/[0-9]+$"
          },
          "source_manifest": {
            "$ref": "#/$defs/artifact"
          },
          "intake_status": {
            "enum": [
              "pending",
              "ready",
              "submitted",
              "certified",
              "qualified",
              "rejected",
              "proof_debt"
            ]
          },
          "intake_packet": {
            "oneOf": [
              {
                "$ref": "#/$defs/artifact"
              },
              {
                "type": "null"
              }
            ]
          },
          "target_claim_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "requested_modalities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "LEAN_FORMALIZATION",
                "COQ_FORMALIZATION",
                "ISABELLE_FORMALIZATION",
                "AGDA_FORMALIZATION",
                "HOL_LIGHT_FORMALIZATION",
                "EXACT_RATIONAL_CERTIFICATE",
                "INTERVAL_ARITHMETIC_CERTIFICATE",
                "SAT_SMT_CERTIFICATE",
                "COMPUTER_ALGEBRA_CERTIFICATE_WITH_REPLAY",
                "SEMANTIC_REPLAY",
                "SPECIALIST_AUDIT_PENDING"
              ]
            }
          },
          "claim_boundary": {
            "type": "string",
            "minLength": 10
          },
          "cert_output": {
            "oneOf": [
              {
                "$ref": "#/$defs/artifact"
              },
              {
                "type": "null"
              }
            ]
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reopening_conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit_sha",
        "path",
        "digest_algorithm",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "digest_algorithm": {
          "enum": [
            "git_blob_sha1",
            "git_tree_sha1",
            "sha256"
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$|^[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "digest_algorithm": {
                "enum": [
                  "git_blob_sha1",
                  "git_tree_sha1"
                ]
              }
            },
            "required": [
              "digest_algorithm"
            ]
          },
          "then": {
            "properties": {
              "digest": {
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "digest_algorithm": {
                "const": "sha256"
              }
            },
            "required": [
              "digest_algorithm"
            ]
          },
          "then": {
            "properties": {
              "digest": {
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      ]
    }
  }
}
