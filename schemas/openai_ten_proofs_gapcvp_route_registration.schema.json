{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/openai_ten_proofs_gapcvp_route_registration.schema.json",
  "title": "OpenAI Ten Proofs GapCVP Route Registration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","record_type","record_id","candidate_id","result_family","route_id","tracker_issue","authority","registration","state","route_controls","activation","candidate_disposition","claim_boundary"],
  "properties": {
    "schema_version": {"const":"1.0.0"},
    "record_type": {"const":"openai_ten_proofs_gapcvp_route_registration"},
    "record_id": {"const":"MC-OTP-H-GAPCVP-ROUTE-REGISTRATION-001"},
    "candidate_id": {"const":"OPENAI-TEN-PROOFS-001"},
    "result_family": {"const":"OTP-H-GAPCVP"},
    "route_id": {"const":"MC-ROUTE-OTP-H-GAPCVP"},
    "tracker_issue": {"const":"https://github.com/grandchallenge/MATHCERT/issues/204"},
    "authority": {
      "type":"object","additionalProperties":false,
      "required":["proposal_merge","proposal_reviewed_head","proposal_review_id","proposal_reviewer","proposal_record","proposal_registry","registration_ci_prerequisite_merge","registration_ci_prerequisite_head","registered_route_registry_before_blob","registered_route_registry_candidate_blob","forge_semantic","solve_handoff","cert_intake_merge","cert_intake_blob","cert_work_package_merge","cert_work_package_blob","cert_replay_evidence_merge","cert_replay_evidence_blob","cert_replay_evidence_id","cert_replay_readback_merge","cert_replay_readback_blob","official_subject"],
      "properties": {
        "proposal_merge":{"const":"284e724d299bac02fc962b68e429b82398f6a08b"},
        "proposal_reviewed_head":{"const":"f1c68cb3c06a4ab5b779f3b3f1134fec53a09ea3"},
        "proposal_review_id":{"const":5036003579},
        "proposal_reviewer":{"const":"jimsteeg"},
        "proposal_record":{"$ref":"#/$defs/artifact"},
        "proposal_registry":{"$ref":"#/$defs/artifact"},
        "registration_ci_prerequisite_merge":{"const":"6bb06fd65f9f8c418a61206f43fa99aa6f1c797f"},
        "registration_ci_prerequisite_head":{"const":"75ad62917ca15c7635ccb904e174bb6e98af3945"},
        "registered_route_registry_before_blob":{"const":"4d5c8e3f2b33d5148d98e7057991e167938c75bb"},
        "registered_route_registry_candidate_blob":{"const":"ffc95950e571efebe1c90a3e6d1bf279b37b71b1"},
        "forge_semantic":{"$ref":"#/$defs/externalArtifact"},
        "solve_handoff":{"$ref":"#/$defs/externalArtifact"},
        "cert_intake_merge":{"const":"ff9fa0a67a5a809f3519e0059f2ef9b082b1febb"},
        "cert_intake_blob":{"const":"a171482c04f62134812ed6084e19a9b803db3478"},
        "cert_work_package_merge":{"const":"10e6f3ee20d7a6e89feb27aef0115fa27710d5e4"},
        "cert_work_package_blob":{"const":"0f811d163f0d36b028cf6539963e2cf278517137"},
        "cert_replay_evidence_merge":{"const":"f34f33b22292ca244956781065fdf84efe2b43f2"},
        "cert_replay_evidence_blob":{"const":"a12f2c553b71f4daec9255e1f254f48a21f439c3"},
        "cert_replay_evidence_id":{"const":"MC-OTP-H-GAPCVP-REPLAY-EVIDENCE-001"},
        "cert_replay_readback_merge":{"const":"1e64a4c147cb8f35255d3effa80342ce64ee3682"},
        "cert_replay_readback_blob":{"const":"fde8ed79681dce929916b524176b236960cac4f6"},
        "official_subject":{
          "type":"object","additionalProperties":false,"required":["repository","commit","tree"],
          "properties":{"repository":{"const":"openai/ten-proofs"},"commit":{"const":"94bc0feb6a9ff12c7d31d6de640a725c9d43d2b6"},"tree":{"const":"174289e4d4958cb0509874e6e53400e098213de7"}}
        }
      }
    },
    "registration": {
      "type":"object","additionalProperties":false,
      "required":["route_status","target_count","target_claim_ids","promise_interfaces","classifications","gap_factors","mandatory_qualifications","permitted_axioms","nonvacuity_state"],
      "properties": {
        "route_status":{"const":"submitted"},
        "target_count":{"const":4},
        "target_claim_ids":{"$ref":"#/$defs/fourStrings"},
        "promise_interfaces":{"$ref":"#/$defs/fourStrings"},
        "classifications":{"$ref":"#/$defs/fourStrings"},
        "gap_factors":{"$ref":"#/$defs/fourStrings"},
        "mandatory_qualifications":{"type":"array","minItems":7,"maxItems":7,"items":{"type":"string","minLength":20}},
        "permitted_axioms":{"type":"array","minItems":3,"maxItems":3,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "nonvacuity_state":{"const":"protected_replay_nonvacuity_clear"}
      }
    },
    "state": {
      "type":"object","additionalProperties":false,
      "required":["registered_route_count_created_by_this_operation","submitted_route_count","adjudication_count","cert_output_count","mathematical_target_proved_count","aggregate_route_count"],
      "properties": {
        "registered_route_count_created_by_this_operation":{"const":1},
        "submitted_route_count":{"const":1},
        "adjudication_count":{"const":0},
        "cert_output_count":{"const":0},
        "mathematical_target_proved_count":{"const":0},
        "aggregate_route_count":{"const":0}
      }
    },
    "route_controls": {
      "type":"object","additionalProperties":false,
      "required":["registration_scope","may_adjudicate","may_issue_cert_output","may_mark_target_proved","may_promote_claim","cross_family_transfer_prohibited","aggregate_route_prohibited","may_broaden_integer_target","may_broaden_consistent_syndrome","may_totalize_outside_promise","may_make_p_input_dependent","may_reinterpret_gap_denominators_as_constants","whole_document_equivalence_established","full_proof_body_equivalence_established"],
      "properties": {
        "registration_scope":{"const":"exact_one_gapcvp_four_target_promise_route"},
        "may_adjudicate":{"const":false},
        "may_issue_cert_output":{"const":false},
        "may_mark_target_proved":{"const":false},
        "may_promote_claim":{"const":false},
        "cross_family_transfer_prohibited":{"const":true},
        "aggregate_route_prohibited":{"const":true},
        "may_broaden_integer_target":{"const":false},
        "may_broaden_consistent_syndrome":{"const":false},
        "may_totalize_outside_promise":{"const":false},
        "may_make_p_input_dependent":{"const":false},
        "may_reinterpret_gap_denominators_as_constants":{"const":false},
        "whole_document_equivalence_established":{"const":false},
        "full_proof_body_equivalence_established":{"const":false}
      }
    },
    "activation": {
      "type":"object","additionalProperties":false,"required":["condition","head_change_requires_reapproval","effect"],
      "properties":{"condition":{"type":"string","minLength":120},"head_change_requires_reapproval":{"const":true},"effect":{"const":"gapcvp_route_registered_no_adjudication_no_output"}}
    },
    "candidate_disposition":{"const":"H_GAPCVP_CERT_ROUTE_REGISTERED__NO_ADJUDICATION_OR_OUTPUT_AUTHORITY"},
    "claim_boundary":{"type":"string","minLength":500}
  },
  "$defs": {
    "artifact": {
      "type":"object","additionalProperties":false,"required":["path","digest_algorithm","digest"],
      "properties":{"path":{"type":"string","minLength":1},"digest_algorithm":{"const":"git_blob_sha1"},"digest":{"type":"string","pattern":"^[0-9a-f]{40}$"}}
    },
    "externalArtifact": {
      "type":"object","additionalProperties":false,"required":["repository","commit_sha","path","digest_algorithm","digest"],
      "properties":{"repository":{"type":"string","minLength":1},"commit_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"path":{"type":"string","minLength":1},"digest_algorithm":{"const":"git_blob_sha1"},"digest":{"type":"string","pattern":"^[0-9a-f]{40}$"}}
    },
    "fourStrings":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"string","minLength":1}}
  }
}
