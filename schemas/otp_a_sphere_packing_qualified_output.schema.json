{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/otp_a_sphere_packing_qualified_output.schema.json",
  "title": "OTP A Sphere Packing future restricted qualification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","record_type","certificate_id","result_family","route_id","encoded_targets","classifications","qualification","state","claim_boundary"],
  "properties": {
    "schema_version":{"const":"1.0.0"},
    "record_type":{"const":"otp_a_sphere_packing_qualified_output"},
    "certificate_id":{"const":"MC-OTP-A-SPHERE-PACKING-QUAL-001"},
    "result_family":{"const":"OTP-A-SPHERE-PACKING"},
    "route_id":{"const":"MC-ROUTE-OTP-A-SPHERE-PACKING"},
    "encoded_targets":{"type":"array","minItems":4,"maxItems":4,"uniqueItems":true,"items":{"type":"string"}},
    "classifications":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"string"}},
    "qualification":{
      "type":"object","additionalProperties":false,
      "required":["disposition","scope","mandatory_qualifications"],
      "properties":{
        "disposition":{"const":"qualified_protected_four_targets_only"},
        "scope":{"type":"string","minLength":20},
        "mandatory_qualifications":{"type":"array","minItems":5,"items":{"type":"string","minLength":10}}
      }
    },
    "state":{
      "type":"object","additionalProperties":false,
      "required":["mathematical_target_proved","aggregate_authority","may_promote_claim"],
      "properties":{
        "mathematical_target_proved":{"const":false},
        "aggregate_authority":{"const":false},
        "may_promote_claim":{"const":false}
      }
    },
    "claim_boundary":{"type":"string","minLength":500}
  }
}
