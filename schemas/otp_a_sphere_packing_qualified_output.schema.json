    "classifications": {"const": ["direct_source_theorem_projection_modulo_proved_full_radial_equivalence","derived_base_two_logarithmic_consequence","source_faithful_displayed_consequence_with_proved_scale_normalization","source_faithful_derived_composite_certificate"]},
