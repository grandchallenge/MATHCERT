    },
    "reviewer_requirements": {
      "type":"object","additionalProperties":false,
      "required":["minimum_binding_non_author_reviewers","required_review_state","review_must_bind_exact_execution_head","competence","independence"],
      "properties":{"minimum_binding_non_author_reviewers":{"const":1},"required_review_state":{"const":"APPROVED"},"review_must_bind_exact_execution_head":{"const":true},"competence":{"type":"array","minItems":4,"items":{"type":"string"}},"independence":{"type":"array","minItems":2,"items":{"type":"string"}}}
    },
    "execution_gate": {
      "type":"object","additionalProperties":false,
      "required":["future_adjudication_execution_required","future_adjudication_output_is_separate_operation","routine_stage_progression_without_human_steward_intervention","human_steward_intervention_required_for_control_plan_change","exact_head_cert_checks_required","exact_head_gcl_conformance_required","fresh_non_author_approval_required","protected_merge_required","head_change_requires_revalidation_and_reapproval","design_merge_effect"],
      "properties":{"future_adjudication_execution_required":{"const":true},"future_adjudication_output_is_separate_operation":{"const":true},"routine_stage_progression_without_human_steward_intervention":{"const":true},"human_steward_intervention_required_for_control_plan_change":{"const":true},"exact_head_cert_checks_required":{"const":true},"exact_head_gcl_conformance_required":{"const":true},"fresh_non_author_approval_required":{"const":true},"protected_merge_required":{"const":true},"head_change_requires_revalidation_and_reapproval":{"const":true},"design_merge_effect":{"const":"contract_admitted_design_only_no_adjudication"}}
