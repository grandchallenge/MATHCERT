{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","record_type","contract_id","campaign_id","workset_id","route_id","contract_state","tracker_issue","authority","route_scope","decision_contract","reviewer_requirements","execution_gate","state","preserved_limitations","claim_boundary"],
  "properties": {
