    "campaign_id": {"const":"VGSE-001"},
    "workset_id": {"const":"VGSE-WP00-CERT-001"},
    "route_id": {"const":"MC-ROUTE-VGSE-001"},
    "contract_state": {"const":"design_only"},
    "tracker_issue": {"const":"https://github.com/grandchallenge/MATHCERT/issues/295"},
    "authority": {
      "type":"object","additionalProperties":false,
      "required":["solve_handoff_merge","solve_handoff_blob","solve_source_manifest_blob","cert_evidence_admission_merge","cert_c06_reconciliation_merge","route_overlay_blob","exact_algebraic_graph_evidence_blob","planar_evidence_blob","c06_producer_binding_blob","c06_producer_merge"],
      "properties": {
        "solve_handoff_merge":{"type":"string"},"solve_handoff_blob":{"type":"string"},"solve_source_manifest_blob":{"type":"string"},"cert_evidence_admission_merge":{"type":"string"},"cert_c06_reconciliation_merge":{"type":"string"},"route_overlay_blob":{"type":"string"},"exact_algebraic_graph_evidence_blob":{"type":"string"},"planar_evidence_blob":{"type":"string"},"c06_producer_binding_blob":{"type":"string"},"c06_producer_merge":{"type":"string"}
      }
    },
    "route_scope": {
      "type":"object","additionalProperties":false,
      "required":["registered_route_state","target_claims","excluded_route_claim_ids","scope_exclusions"],
      "properties": {
        "registered_route_state":{"const":"registered_pending_evidence"},
        "target_claims":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"object","additionalProperties":false,"required":["claim_id","statement","support_type","evidence_path"],"properties":{"claim_id":{"type":"string"},"statement":{"type":"string"},"support_type":{"type":"string"},"evidence_path":{"type":"string"}}}},
        "excluded_route_claim_ids":{"const":["VGSE-C06"]},
        "scope_exclusions":{"type":"array","minItems":5,"items":{"type":"string"}}
      }
    },
    "decision_contract": {
      "type":"object","additionalProperties":false,
      "required":["decision_question","admissible_dispositions","required_evidence"],
      "properties": {
        "decision_question":{"type":"string"},
        "admissible_dispositions":{"const":["adjudication_clear_exact_four_claims_only","adjudication_not_clear","defer_insufficient_evidence"]},
        "required_evidence":{"type":"array","minItems":9,"items":{"type":"string"}}
