      "required":["c06_in_scope","c06_state","source_paper_refutation_authorized","equivalence_group_broadening_authorized","mechanical_claim_authorized","manufacturing_claim_authorized","novelty_or_priority_claim_authorized","patentability_claim_authorized","product_or_commercial_claim_authorized"],
      "properties":{"c06_in_scope":{"const":false},"c06_state":{"const":"BLOCKED_VISIBLE_GEOMETRIC_WEIGHT_BRIDGE_TO_PINNED_C"},"source_paper_refutation_authorized":{"const":false},"equivalence_group_broadening_authorized":{"const":false},"mechanical_claim_authorized":{"const":false},"manufacturing_claim_authorized":{"const":false},"novelty_or_priority_claim_authorized":{"const":false},"patentability_claim_authorized":{"const":false},"product_or_commercial_claim_authorized":{"const":false}}
    },
