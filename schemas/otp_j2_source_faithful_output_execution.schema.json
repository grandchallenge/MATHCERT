{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/otp_j2_source_faithful_output_execution.schema.json",
  "title": "OTP-J2-TWO-DEGENERATE source-faithful restricted qualification execution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "execution_id",
    "candidate_id",
    "result_family",
    "route_id",
    "contract_id",
    "tracker_issue",
    "protected_authority",
    "execution_commits",
    "staged_evidence",
    "encoded_targets",
    "qualification",
    "candidate_state",
    "branch_execution_state",
    "publication_gate",
    "review_gate",
    "preserved_limitations",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "otp_j2_source_faithful_output_execution"},
    "execution_id": {"const": "MC-OTP-J2-TWO-DEGENERATE-OUTPUT-EXEC-001"},
    "candidate_id": {"const": "MC-OTP-J2-TWO-DEGENERATE-OUTPUT-CANDIDATE-001"},
    "result_family": {"const": "OTP-J2-TWO-DEGENERATE"},
    "route_id": {"const": "MC-ROUTE-OTP-J2-TWO-DEGENERATE"},
    "contract_id": {"const": "MC-OTP-J2-TWO-DEGENERATE-OUTPUT-CONTRACT-001"},
    "tracker_issue": {"const": "https://github.com/grandchallenge/MATHCERT/issues/130"},
    "protected_authority": {"type": "object"},
    "execution_commits": {"type": "object"},
    "staged_evidence": {"type": "object"},
    "encoded_targets": {
      "const": [
        "TwoDegenerateGraphs.mathcert_sourceFaithfulTwoDegenerateExtremalCounterexample",
        "TwoDegenerateGraphs.mathcert_sourceFaithfulNotErdos146"
      ]
    },
    "qualification": {
      "const": {
        "disposition": "qualified_source_faithful_targets_only",
        "scope": "The exact two source-faithful OTP-J2-TWO-DEGENERATE projection declarations only.",
        "source_locus": "Current Chapter 10, Theorem 1.2 core only.",
        "mathematical_target_proved": false
      }
    },
    "candidate_state": {"const": "output_candidate_prepared_pending_execution"},
    "branch_execution_state": {"type": "object"},
    "publication_gate": {"type": "object"},
    "review_gate": {
      "const": {
        "minimum_binding_non_author_reviewers": 1,
        "required_review_state": "APPROVED",
        "review_must_bind_exact_execution_head": true,
        "recorded_review": null
      }
    },
    "preserved_limitations": {
      "const": {
        "historical_stronger_targets_qualified": false,
        "stronger_coloring_property_source_authorized": false,
        "stronger_coloring_property_certified": false,
        "whole_document_byte_equivalence": "not_established",
        "whole_document_semantic_equivalence": "not_established",
        "proof_body_compared_in_full": false,
        "source_internal_entropy_lemmas_reformalized": false,
        "unrestricted_source_theorem_proof_claim": false,
        "other_family_outputs_authorized": false,
        "aggregate_openai_ten_proofs_authority": false
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1100}
  }
}
