{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/formal_target_certificate.schema.json",
  "title": "MATHCERT formal target interface certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "certificate_id",
    "campaign_id",
    "solve_provider",
    "cert_replay",
    "source_identity_verified",
    "extraction_replayed",
    "target_declaration_elaborated",
    "concordance_theorem_kernel_checked",
    "axiom_report",
    "sorry_inventory",
    "mathematical_target_proved",
    "disposition",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "certificate_id": {"type": "string", "pattern": "^MC-FC-WP00-[A-Z0-9-]+$"},
    "campaign_id": {"enum": ["RH-001", "NS-CI-001"]},
    "solve_provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "merge_commit", "manifest", "handoff", "target_sources", "target_record"],
      "properties": {
        "repository": {"const": "grandchallenge/MATHSOLVE"},
        "merge_commit": {"const": "916f3434abcce29098ba7508a3b457a461461193"},
        "manifest": {"$ref": "#/$defs/artifact"},
        "handoff": {"$ref": "#/$defs/artifact"},
        "target_sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
        "target_record": {"$ref": "#/$defs/artifact"}
      }
    },
    "cert_replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "source_commit", "module", "module_blob", "lean_toolchain", "mathlib_commit"],
      "properties": {
        "repository": {"const": "grandchallenge/MATHCERT"},
        "source_commit": {"const": "89371038b5d3fe526387a9767a48ac5bd6e527b1"},
        "module": {"const": "MathCert/FormalSources/RHNSReplay.lean"},
        "module_blob": {"const": "c807eaa8a79c470d52b2d06223b539fe8f79787d"},
        "lean_toolchain": {"const": "leanprover/lean4:v4.29.1"},
        "mathlib_commit": {"const": "5e932f97dd25535344f80f9dd8da3aab83df0fe6"}
      }
    },
    "source_identity_verified": {"const": true},
    "extraction_replayed": {"const": true},
    "target_declaration_elaborated": {"const": true},
    "concordance_theorem_kernel_checked": {"type": "boolean"},
    "axiom_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kernel_axioms", "imported_domain_axioms", "unexpected_axioms"],
      "properties": {
        "kernel_axioms": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "imported_domain_axioms": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "unexpected_axioms": {"type": "array", "maxItems": 0}
      }
    },
    "sorry_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sorry_count", "admit_count"],
      "properties": {
        "sorry_count": {"const": 0},
        "admit_count": {"const": 0}
      }
    },
    "mathematical_target_proved": {"const": false},
    "disposition": {"const": "qualified_interface_only"},
    "claim_boundary": {"type": "string", "minLength": 40}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest_algorithm", "digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "digest_algorithm": {"const": "git_blob_sha1"},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    }
  }
}
